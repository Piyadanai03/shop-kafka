{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "resolveJsonModule": true,

    "declaration": true,
    "declarationMap": true,

    "noEmit": true,

    // Production build settings
    // "noEmit": false,
    // "outDir": "dist",

    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
